{
  "expo": {
    "name": "Defineciler",
    "slug": "defineciler",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "defineciler",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#121D19",
    "primaryColor": "#D4A24C",
    "description": "Yapay zeka ile tarihi eser tanımlama: fotoğrafını çek, dönemini, uygarlığını ve içeriğini öğren.",
    "android": {
      "package": "com.dronopter.defineciler",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#121D19",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": ["android.permission.CAMERA", "android.permission.INTERNET"],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO"
      ],
      "predictiveBackGestureEnabled": false
    },
    "ios": {
      "bundleIdentifier": "com.dronopter.defineciler"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#121D19",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 180
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Eserin fotoğrafını çekip yapay zeka ile analiz edebilmek için kameraya erişim gerekiyor.",
          "photosPermission": "Galerinizdeki eser fotoğraflarını analiz edebilmek için fotoğraflara erişim gerekiyor.",
          "microphonePermission": false
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-3204109869365538~6941164437",
          "androidSdk": "classic",
          "iosAppId": "ca-app-pub-3940256099942544~1458002511",
          "delayAppMeasurementInit": true
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "useLegacyPackaging": true
          }
        }
      ]
    ],
    "extra": {
      "apiUrl": "",
      "appKey": "defineciler-android-v1",
      "dailyFreeScans": 3
    },
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
