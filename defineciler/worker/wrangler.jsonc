{
  // Cloudflare Worker: Gemini API anahtarını uygulamadan gizleyen ara sunucu.
  // Kurulum adımları için ../README.md dosyasına bakın.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "defineciler-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "observability": { "enabled": true },
  "vars": {
    // Gemini modelleri (13 Eki, fotoğraflı gerçek ölçüm, bkz. .github/workflows/defineciler-gemini-check.yml):
    // gemini-3-flash-preview ~15 sn, gemini-3.8-flash ~24 sn çalıştı. 3.5/3.6/3.7-flash yoğunlukta 503,
    // flash-lite modelleri 500 veya zaman aşımı (60+ sn takılma) verdi, 2.5 modelleri yeni kullanıcılara kapalı (404).
    // Sıra önemli: yanıt vermeyen model süre bütçesini tüketir, çalışanlar öne alınır.
    "GEMINI_MODEL": "gemini-3-flash-preview",
    "GEMINI_FALLBACK_MODELS": "gemini-3.8-flash,gemini-3.5-flash,gemini-3.6-flash",
    // Uygulamanın gönderdiği X-App-Key başlığı (app.json → extra.appKey ile aynı olmalı).
    "APP_KEY": "defineciler-android-v1",
    // Günlük sınırlar (USAGE KV bağlıysa uygulanır; dağıtım iş akışı KV'yi kendisi oluşturup bağlar).
    // Cihaz başına: 2 ücretsiz + reklamla açılan analizler için cömert, kötüye kullanıma kapalı.
    "DEVICE_DAILY_LIMIT": "15",
    // Pro aboneler (RevenueCat ile doğrulanır): uygulamada günde 30, sunucuda küçük bir pay bırakılır.
    "PRO_DEVICE_DAILY_LIMIT": "35",
    // IP başına: mobil operatörlerde çok kullanıcı aynı IP'yi paylaşabilir, bu yüzden geniş.
    "DAILY_LIMIT_PER_IP": "150",
    // Tüm kullanıcılar için günlük toplam: ücretsiz Gemini kotasını ve ileride faturayı korur.
    "GLOBAL_DAILY_LIMIT": "1500"
  },
  // IP başına dakikada en fazla 6 analiz isteği.
  "ratelimits": [
    { "name": "ANALYZE_LIMITER", "namespace_id": "1001", "simple": { "limit": 6, "period": 60 } }
  ]
  // USAGE (günlük sayaçlar + sonuç önbelleği) KV'si: .github/scripts/ensure-kv.mjs oluşturup bağlar.
  // Elle kurmak için: npx wrangler kv namespace create USAGE, çıkan id'yi şuraya yazın:
  // "kv_namespaces": [{ "binding": "USAGE", "id": "<id>" }]
}
