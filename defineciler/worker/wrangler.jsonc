{
  // Cloudflare Worker: Gemini API anahtarını uygulamadan gizleyen ara sunucu.
  // Kurulum adımları için ../README.md dosyasına bakın.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "defineciler-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "observability": { "enabled": true },
  "vars": {
    // Gemini model adı. Gerçek fotoğrafla ölçüm (9 Eki): 3.5-flash ~14 sn, flash-lite ~17 sn,
    // 3.8-flash ~50 sn (uygulamanın bekleme süresini aşıyordu). Bkz. .github/scripts/bench-gemini.mts
    "GEMINI_MODEL": "gemini-3.5-flash",
    // Ana model yoğunsa (503) veya kota dolarsa sırayla denenecek yedek modeller.
    "GEMINI_FALLBACK_MODELS": "gemini-flash-lite-latest,gemini-3.8-flash",
    // Uygulamanın gönderdiği X-App-Key başlığı (app.json → extra.appKey ile aynı olmalı).
    "APP_KEY": "defineciler-android-v1",
    // IP başına günlük en fazla analiz (USAGE KV bağlıysa uygulanır).
    "DAILY_LIMIT_PER_IP": "30"
  },
  // IP başına dakikada en fazla 6 analiz isteği.
  "ratelimits": [
    { "name": "ANALYZE_LIMITER", "namespace_id": "1001", "simple": { "limit": 6, "period": 60 } }
  ]
  // Günlük limit için isteğe bağlı KV:
  //   npx wrangler kv namespace create USAGE
  // komutunun verdiği id ile aşağıdakini ekleyin:
  // "kv_namespaces": [{ "binding": "USAGE", "id": "<id>" }]
}
